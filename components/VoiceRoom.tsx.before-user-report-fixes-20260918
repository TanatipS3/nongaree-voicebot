                    key={cellIndex}
                    style={{ width: tableColumnWidth(header.length, cellIndex) }}
                  />
                ))}
              </colgroup>
              <thead>
                <tr>
                  {header.map((cell, cellIndex) => (
                    <th
                      key={cellIndex}
                      style={{
                        borderBottom: '1px solid rgba(62,163,203,0.28)',
                        color: '#25657c',
                        fontWeight: 700,
                        padding: '7px 10px',
                        textAlign: 'left',
                      }}
                    >
                      {renderInlineMarkdown(cleanDetailDisplayText(cell))}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {rows.map((row, rowIndex) => (
                  <tr key={rowIndex}>
                    {header.map((_, cellIndex) => (
                      <td
                        key={cellIndex}
                        style={{
                          borderBottom: '1px solid rgba(62,163,203,0.16)',
                          padding: '8px 10px',
                          overflowWrap: 'break-word',
                          wordBreak: 'normal',
                          verticalAlign: 'top',
                        }}
                      >
                        {renderTableCell(row[cellIndex] || '')}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>,
        );
        continue;
      }

      const bullet = line.match(/^\s*[-*]\s+(.+)$/);
      if (bullet) {
        blocks.push(
          <div key={index} style={{ display: 'flex', gap: 7, marginTop: blocks.length ? 4 : 0 }}>
            <span style={{ opacity: 0.65 }}>•</span>
            <span>{renderInlineMarkdown(bullet[1])}</span>
          </div>,
        );
        index += 1;
        continue;
      }

      const numbered = line.match(/^\s*(\d+)[.)]\s+(.+)$/);
      if (numbered) {
        blocks.push(
          <div key={index} style={{ display: 'flex', gap: 7, marginTop: blocks.length ? 4 : 0 }}>
            <span style={{ opacity: 0.65 }}>{numbered[1]}.</span>
            <span>{renderInlineMarkdown(numbered[2])}</span>
          </div>,
        );
        index += 1;
        continue;
      }

      const heading = line.match(/^(#{1,3})\s+(.+)$/);
      if (heading) {
        const level = heading[1].length;
        blocks.push(
          <div
            key={index}
            style={{
              color: '#fff',
              fontWeight: 700,
              fontSize: level === 1 ? 18 : level === 2 ? 17 : 16,
              marginTop: blocks.length ? 10 : 0,
              marginBottom: 2,
            }}
          >
            {renderInlineMarkdown(heading[2])}
          </div>,
        );
        index += 1;
        continue;
      }

      const blockquote = line.match(/^\s*>\s+(.+)$/);
      if (blockquote) {
        blocks.push(
          <div
            key={index}
            style={{
              borderLeft: '2px solid rgba(255,255,255,0.28)',
              color: 'rgba(255,255,255,0.78)',
              marginTop: blocks.length ? 8 : 0,
              paddingLeft: 9,
            }}
          >
            {renderInlineMarkdown(blockquote[1])}
          </div>,
        );
        index += 1;
        continue;
      }

      if (/^\s*---+\s*$/.test(line)) {
        blocks.push(
          <div
            key={index}
            style={{
              borderTop: '1px solid rgba(255,255,255,0.14)',
              margin: blocks.length ? '10px 0 6px' : '4px 0 6px',
            }}
          />,
        );
        index += 1;
        continue;
      }

      if (!line.trim()) {
        blocks.push(<div key={index} style={{ height: 8 }} />);
        index += 1;
        continue;
      }

      blocks.push(
        <div key={index} style={{ marginTop: blocks.length ? 4 : 0 }}>
          {renderInlineMarkdown(line)}
        </div>,
      );
      index += 1;
    }

    return blocks;
  }

  useEffect(() => {
    let cancelled = false;
    // Safari can surface LiveKit's internal lossy data-channel errors after a
    // stale/reconnected session. The app uses reliable data packets for chat;
    // keep the demo usable by hiding only the engine-level SDK error overlay.
    setLogLevel(LogLevel.silent, LoggerNames.Engine);
    const room = new Room({
      audioCaptureDefaults: {
        echoCancellation: true,
        noiseSuppression: true,
      },
    });
    roomRef.current = room;
    localAudioTrackRef.current = null;
    let audioCtx: AudioContext | null = null;
    let rafId = 0;
    const attachedElements: HTMLMediaElement[] = [];
    // The analyser watches ONE track, but more than one agent audio track can be
    // subscribed at once — the token route removes duplicate agents after they have
    // already joined (a stale dispatch, a reconnect, a StrictMode double fetch). Track
    // which one is analysed so removing the OTHER agent does not kill it.
    let analysedTrack: RemoteTrack | null = null;
    const subscribedAudio: RemoteTrack[] = [];

    // Keep an agent in the room. The token route dispatches only when it sees NO agent
    // participant, but an agent whose user just closed the tab lingers for up to ~25s
    // before its session closes. Reopen inside that window and the route reuses the
    // dying agent, it leaves a moment later, and nothing ever dispatches another: every
    // question then times out until a manual reload (HANDOFF.md §3e, OPEN reconnect race).
    // The same dead end follows an agent crash or a worker restart mid-session.
    //
    // Recovery re-requests the token route WITHOUT reconnecting the room — the route's
    // dispatch logic runs on every request, and the returned token is simply unused.
    // Reconnecting instead would make the next agent see this participant leave and end
    // its own job, recreating the race it is meant to fix.
    let agentCheckTimer: ReturnType<typeof setTimeout> | null = null;
    const isAgentParticipant = (participant: RemoteParticipant) =>
      participant.kind === ParticipantKind.AGENT || participant.identity.startsWith('agent-');
    const roomHasAgent = () =>
      Array.from(room.remoteParticipants.values()).some(isAgentParticipant);
    function clearAgentCheck() {
      if (agentCheckTimer) clearTimeout(agentCheckTimer);
      agentCheckTimer = null;
    }
    function scheduleAgentCheck(delayMs: number) {
      clearAgentCheck();
      agentCheckTimer = setTimeout(() => {
        agentCheckTimer = null;
        if (cancelled || roomRef.current !== room) return;
        if (room.state !== ConnectionState.Connected || roomHasAgent()) return;
        if (agentRedispatchCountRef.current >= MAX_AGENT_REDISPATCHES) {
          console.warn('[VoiceRoom] no agent after repeated dispatch requests; giving up');
          return;
        }
        agentRedispatchCountRef.current += 1;
        console.warn(
          `[VoiceRoom] no agent in room; requesting dispatch (${agentRedispatchCountRef.current}/${MAX_AGENT_REDISPATCHES})`,
        );
        void fetch(`/api/livekit/token?room=${encodeURIComponent(roomName)}`).catch(() => {});
        scheduleAgentCheck(AGENT_REDISPATCH_RETRY_MS);
      }, delayMs);
    }

    // The start screen used to double as the user gesture that unblocks audio
    // playback. Without it, the browser autoplay policy can mute Aree's greeting
    // until the first interaction — recover it on any pointer/keyboard input and
    // surface a fallback prompt while playback is still blocked.
    const unlockAudio = () => {
      if (cancelled) return;
      if (audioCtx?.state === 'suspended') void audioCtx.resume().catch(() => {});
      if (!room.canPlaybackAudio) void room.startAudio().catch(() => {});
    };
    window.addEventListener('pointerdown', unlockAudio);
    window.addEventListener('keydown', unlockAudio);

    function stopAnalyser() {
      cancelAnimationFrame(rafId);
      audioCtx?.close();
      audioCtx = null;
      analysedTrack = null;
      // A stopped analyser can never update isAgentSpeaking again, so leaving it as-is
      // freezes it at whatever the last frame said. Frozen `true` keeps rawBusy true,
      // the settle timer never starts, turnActive never clears, and every later
      // question is queued forever ("กำลังตอบ" / เข้าคิว). Always reset on stop.
      if (isAgentSpeakingRef.current) {
        isAgentSpeakingRef.current = false;
        setIsAgentSpeaking(false);
      }
    }

    function startAnalyser(track: RemoteTrack) {
      stopAnalyser();
      analysedTrack = track;
      // May start suspended when no user gesture has happened yet; unlockAudio()
      // resumes it on the first interaction.
      audioCtx = new AudioContext();
      void audioCtx.resume().catch(() => {});
      const analyser = audioCtx.createAnalyser();
      analyser.fftSize = 256;

      const source = audioCtx.createMediaStreamSource(
        new MediaStream([track.mediaStreamTrack]),
      );
      source.connect(analyser);

      const buf = new Float32Array(analyser.fftSize);
      function loop() {
        analyser.getFloatTimeDomainData(buf);
        let sum = 0;
        for (let i = 0; i < buf.length; i++) sum += buf[i] * buf[i];
        const rms = Math.sqrt(sum / buf.length);
        faceRef.current?.setAmplitude(rms);
        const speaking = rms > 0.01;
        if (speaking !== isAgentSpeakingRef.current) {
          isAgentSpeakingRef.current = speaking;
          setIsAgentSpeaking(speaking);
        }
        if (speaking) {
          setGaze('agent_talking');
        } else if (gazeStateRef.current !== 'user_talking') {
          setGaze('idle');
        }
        rafId = requestAnimationFrame(loop);
      }
      rafId = requestAnimationFrame(loop);
    }

    room
      .on(RoomEvent.AudioPlaybackStatusChanged, () => {
        if (cancelled) return;
        setNeedsAudioUnlock(!room.canPlaybackAudio);
      })
      .on(RoomEvent.ConnectionStateChanged, (state: ConnectionState) => {
        if (cancelled) return;
        if (state === ConnectionState.Connected) setStatus('connected');
        else if (state === ConnectionState.Disconnected) {
          clearAgentCheck();
          setStatus('disconnected');
          supersedeOnNextDeltaRef.current = false;
          pendingUserTextRef.current = '';
          setAwaitingAnswer(false);
          setPendingQueue([]);
          pendingQueueRef.current = [];
          turnActiveRef.current = false;
          setTurnActive(false);
          if (settleTimerRef.current) {
            clearTimeout(settleTimerRef.current);
            settleTimerRef.current = null;
          }
        }
      })
      .on(RoomEvent.ParticipantConnected, (participant: RemoteParticipant) => {
        if (cancelled || !isAgentParticipant(participant)) return;
        agentRedispatchCountRef.current = 0;
        clearAgentCheck();
      })
      .on(RoomEvent.ParticipantDisconnected, (participant: RemoteParticipant) => {
        if (cancelled || !isAgentParticipant(participant)) return;
        // A duplicate removed while another agent stays is normal — only act when the
        // room is left with none.
        if (!roomHasAgent()) scheduleAgentCheck(AGENT_ABSENT_GRACE_MS);
      })
      .on(
        RoomEvent.TrackSubscribed,
        (track: RemoteTrack) => {
          if (track.kind !== Track.Kind.Audio) return;
          const el = track.attach();
          document.body.appendChild(el);
          attachedElements.push(el);
          subscribedAudio.push(track);
          startAnalyser(track);
        },
      )
      .on(RoomEvent.TrackUnsubscribed, (track: RemoteTrack) => {
        if (track.kind !== Track.Kind.Audio) return;
        track.detach().forEach((el) => el.remove());
        const index = subscribedAudio.indexOf(track);
        if (index >= 0) subscribedAudio.splice(index, 1);
        // Only tear down the analyser if THIS was the track it was watching. It used to
        // stop unconditionally, so when a duplicate agent was removed after a second one
        // had joined, the analyser for the agent still in the room was cancelled and
        // isAgentSpeaking froze mid-greeting — reproduced by dispatching a second agent
        // and removing the first: the analyser's frame counter stopped dead and the UI
        // stayed on "กำลังตอบ", queueing every later question.
        if (track !== analysedTrack) return;
        stopAnalyser();
        faceRef.current?.setAmplitude(0);
        // Hand the analyser to an agent track that is still here, if any.
        const survivor = subscribedAudio[subscribedAudio.length - 1];
        if (survivor) startAnalyser(survivor);
      })
      .on(RoomEvent.DataReceived, (payload: Uint8Array) => {
        const text = new TextDecoder().decode(payload);
        console.log('Received data packet:', text);

        try {
          const msg = JSON.parse(text) as {
            type?: string;
            text?: string;
            emotion?: string;
            requestId?: string;
            sources?: AnswerSource[];
            diagnostics?: AnswerDiagnostics;
          };
          if (msg.type === 'chat_user') {
            // A typed turn has already run sendTextMessage(), which sets the
            // supersede flag; a voice turn arrives here first.
            lastInputModeRef.current = supersedeOnNextDeltaRef.current ? 'typed' : 'voice';
            lastActivityRef.current = Date.now();
            startSessionHistoryEntry(msg.text || '');
            speechPreviewRef.current = '';
            lastVoiceDeltaRef.current = '';
            beginPendingAnswer(msg.text || '');
            setSpeechPreview('กำลังเตรียมคำตอบสั้น...');
            setGaze('agent_thinking');
            startResponseTimeout();
          }
          if (msg.type === 'chat_sources') {
            setSources(Array.isArray(msg.sources) ? msg.sources : []);
            setDiagnostics(msg.diagnostics || {});
            setOpenSource(null);
          }
          if (msg.type === 'chat_status') {
            // While the previous answer is still on screen, the LOADING badge carries
            // the status; overwriting here is what used to blank it.
            if (!supersedeOnNextDeltaRef.current) {
              detailPreviewRef.current = msg.text || 'กำลังคิดคำตอบละเอียด...';
              setSmartDetailPreview(detailPreviewRef.current);
            }
          }
          if (msg.type === 'voice_delta') {
            const nextDelta = msg.text || '';
            if (!nextDelta || nextDelta === lastVoiceDeltaRef.current) {
              return;
            }
            lastVoiceDeltaRef.current = nextDelta;
            if (speechPreviewRef.current === 'กำลังเตรียมคำตอบสั้น...') {
              speechPreviewRef.current = '';
            }
            speechPreviewRef.current += nextDelta;
            setSpeechPreview(speechPreviewRef.current.trim());
            updateSessionHistoryEntry('voiceAnswer', speechPreviewRef.current.trim());
            noteAnswerProgress('voice');
          }
          if (msg.type === 'voice_answer') {
            // May arrive with EMPTY text: the agent now always closes the voice turn,
            // even when the spoken reply produced nothing, precisely so this placeholder
            // is cleared. `msg.text || ref` with an empty ref sets the state to ''.
            lastVoiceDeltaRef.current = '';
            speechPreviewRef.current = msg.text || speechPreviewRef.current;
            setSpeechPreview(speechPreviewRef.current.trim());
            updateSessionHistoryEntry('voiceAnswer', speechPreviewRef.current.trim());
            noteAnswerProgress('voice');
          }
          if (msg.type === 'chat_delta') {
            commitPendingAnswer();
            if (
              detailPreviewRef.current === 'กำลังคิดคำตอบ...' ||
              detailPreviewRef.current === 'กำลังคิดคำตอบละเอียด...'
            ) {
              detailPreviewRef.current = '';
            }
            detailPreviewRef.current += msg.text || '';
            setSmartDetailPreview(detailPreviewRef.current.trim());
            updateSessionHistoryEntry('detailAnswer', detailPreviewRef.current.trim());
            noteAnswerProgress('panel');
          }
          if (msg.type === 'chat_answer') {
            if (msg.text) commitPendingAnswer();
            detailPreviewRef.current = msg.text || detailPreviewRef.current;
            setSmartDetailPreview(detailPreviewRef.current.trim());
            updateSessionHistoryEntry('detailAnswer', detailPreviewRef.current.trim());
            if (msg.text) noteAnswerProgress('panel');
          }
          if (msg.emotion && VALID_MODES.has(msg.emotion.toLowerCase() as FaceMode)) {
            faceRef.current?.setMode(msg.emotion.toLowerCase() as FaceMode);
          }
          if (msg.type?.startsWith('chat_') || msg.emotion) return;
        } catch {
          // Legacy emotion packets are plain text, handled below.
        }

        const match = text.match(/\[EMOTION:(\w+)\]/i);
        if (!match) return;
        const emotion = match[1].toLowerCase() as FaceMode;
        console.log('Matched emotion:', emotion);
        if (!VALID_MODES.has(emotion)) return;
        faceRef.current?.setMode(emotion);
      });

    (async () => {
      try {
        const res = await fetch(
          `/api/livekit/token?room=${encodeURIComponent(roomName)}`,
        );
        if (!res.ok) throw new Error('Token fetch failed');
        const { token, url } = (await res.json()) as { token: string; url: string };
        if (cancelled) return;
        await room.connect(url, token);
        if (cancelled) return;
        // Covers the agent having already left before this page finished joining, when no
        // ParticipantDisconnected will ever be seen here.
        if (!roomHasAgent()) scheduleAgentCheck(AGENT_ABSENT_GRACE_MS);

        const localTrack = await createLocalAudioTrack({
          echoCancellation: true,
          noiseSuppression: true,
        });
        localAudioTrackRef.current = localTrack;
        await localTrack.mute();
        await room.localParticipant.publishTrack(localTrack);
        if (!cancelled) {
          setMicReady(true);
          setMicError('');
        }
      } catch (error) {
        localAudioTrackRef.current = null;
        if (!cancelled) {
          setMicReady(false);
          setMicError(describeMicError(error));
          setMicErrorName(error instanceof DOMException ? error.name : 'Error');
          setStatus(
            room.state === ConnectionState.Connected ? 'connected' : 'disconnected',
          );
        }
      }
    })();

    return () => {
      cancelled = true;
      clearAgentCheck();
      window.removeEventListener('pointerdown', unlockAudio);
      window.removeEventListener('keydown', unlockAudio);
      roomRef.current = null;
      localAudioTrackRef.current?.stop();
      localAudioTrackRef.current = null;
      recognitionRef.current?.abort();
      recognitionRef.current = null;
      browserTranscriptRef.current = '';
      talkingActiveRef.current = false;
      stopTalkingInFlightRef.current = false;
      clearResponseTimeout();
      setMicReady(false);
      stopAnalyser();
      attachedElements.forEach((el) => el.remove());
      room.disconnect();
    };
  }, [
    roomName,
    connectAttempt,
    setSmartDetailPreview,
    startSessionHistoryEntry,
    updateSessionHistoryEntry,
  ]);

  // The turn being reported — the newest history entry. Null when nothing has been
  // answered yet, which is exactly the "ระบบค้าง / ไม่ตอบ" case and the one most worth
  // reporting, so the dialog must stay usable without it.
  const reportedTurn = sessionHistory.length
    ? sessionHistory[sessionHistory.length - 1]
    : null;

  const submitReport = useCallback(async () => {
    const message = reportMessage.trim();
    if (!message) return;
    setReportState('sending');
    lastActivityRef.current = Date.now();

    // Bounded, NOT the whole session: history holds up to MAX_SESSION_HISTORY_ENTRIES
    // (80), and shipping all of it would mean dozens of turns of someone's salary and
    // children for one complaint. Three covers context-dependent bugs.
    const preceding = sessionHistory
      .slice(Math.max(0, sessionHistory.length - 1 - REPORT_PRECEDING_TURNS), sessionHistory.length - 1)
      .map((entry) => ({
        history_id: entry.id,
        asked_at: entry.time,
        question: entry.question,
        detail_answer: entry.detailAnswer,
      }));

    try {
      const res = await fetch('/api/report', {
        method: 'POST',
        headers: { 'content-type': 'application/json; charset=utf-8' },
        body: JSON.stringify({
          type: reportType,
          message,
          turn: reportedTurn
            ? {
                history_id: reportedTurn.id,
                asked_at: reportedTurn.time,
                question: reportedTurn.question,
                voice_answer: reportedTurn.voiceAnswer,
                detail_answer: reportedTurn.detailAnswer,
                input_mode: lastInputModeRef.current,
              }
            : null,
          sources,
          diagnostics,
          preceding_turns: preceding,
          client: {
            connection_status: status,
            mic_ready: micReady,
            mic_error: micErrorName,
            turn_active: turnActive,
            queued_questions: pendingQueue.length,
            viewport: `${window.innerWidth}x${window.innerHeight}`,
          },
        }),
      });
      if (!res.ok) throw new Error(String(res.status));
      setReportState('sent');
      setReportMessage('');
    } catch {
      setReportState('error');
    }
  }, [
    reportMessage, reportType, reportedTurn, sessionHistory, sources, diagnostics,
    status, micReady, micErrorName, turnActive, pendingQueue,
  ]);

  const openReport = useCallback(() => {
    setReportState('idle');
    setReportOpen(true);
  }, []);

  // Re-runs the room effect from scratch: full teardown in its cleanup, then a fresh
  // token, room and microphone. Before this there was no recovery from a failed mic
  // or a dropped connection short of the user reloading the page.
  const handleRetryConnection = useCallback(() => {
    lastActivityRef.current = Date.now();
    setMicError('');
    setMicErrorName('');
    setStatus('connecting');
    setConnectAttempt((value) => value + 1);
  }, []);

  const sendTextMessage = useCallback(async (text: string) => {
    if (!roomRef.current || !text.trim()) return;
    lastActivityRef.current = Date.now();
    const cleanText = text.trim();
    const manualEmotion = getManualEmotionCommand(cleanText);
    if (manualEmotion) {
      speechPreviewRef.current = '';
      detailPreviewRef.current = '';
      setCurrentUserText(cleanText);
      setSpeechPreview('');
      setSmartDetailPreview(manualEmotion === 'idle' ? 'กลับสู่อารมณ์ปกติ' : `แสดงอารมณ์: ${manualEmotion}`);
      setGaze('idle');
      clearResponseTimeout();
      faceRef.current?.setMode(manualEmotion);
      return;
    }
    speechPreviewRef.current = '';
    lastInputModeRef.current = 'typed';
    startSessionHistoryEntry(cleanText);
    beginPendingAnswer(cleanText);
    turnActiveRef.current = true;
    setTurnActive(true);
    setSpeechPreview('กำลังเตรียมคำตอบสั้น...');
    setGaze('agent_thinking');
    startResponseTimeout();
    const encoder = new TextEncoder();
    const payload = encoder.encode(JSON.stringify({ type: 'text_input', text: cleanText }));
    await roomRef.current.localParticipant.publishData(payload, { reliable: true });
  }, [startSessionHistoryEntry]);

  const submitQuestion = useCallback((text: string) => {
    const trimmed = text.trim();
    if (!trimmed) return;
    if (turnActiveRef.current || pendingQueueRef.current.length > 0) {
      pendingQueueRef.current = [...pendingQueueRef.current, trimmed];
      setPendingQueue((q) => [...q, trimmed]);
    } else {
      void sendTextMessage(trimmed);
    }
  }, [sendTextMessage]);

  const startBrowserSpeechRecognition = useCallback(() => {
    if (!BROWSER_STT_FALLBACK || typeof window === 'undefined') return;
    const Recognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    if (!Recognition) {
      setMicError('เบราว์เซอร์นี้ยังไม่รองรับการถอดเสียงจากไมโครโฟน กรุณาใช้ Chrome หรือเปิด STT server');
      return;
    }

    recognitionRef.current?.abort();
    browserTranscriptRef.current = '';
    const recognition = new Recognition();
    recognition.lang = 'th-TH';
    recognition.continuous = true;
    recognition.interimResults = true;
    recognition.onresult = (event) => {
      let transcript = '';
      for (let index = event.resultIndex; index < event.results.length; index += 1) {
        transcript += event.results[index]?.[0]?.transcript || '';
      }
      const cleanTranscript = transcript.trim();
      if (cleanTranscript) {
        browserTranscriptRef.current = cleanTranscript;
        if (interruptOnSpeechRef.current && !interruptSentRef.current) {
          interruptSentRef.current = true;
          const payload = new TextEncoder().encode(JSON.stringify({ type: 'interrupt' }));
          roomRef.current?.localParticipant.publishData(payload, { reliable: true }).catch(() => {
            interruptSentRef.current = false;
          });
          isAgentSpeakingRef.current = false;
          setIsAgentSpeaking(false);
        }
      }
    };
    recognition.onerror = (event) => {
      if (event.error === 'no-speech') return;
      setMicError(event.message || `ไมโครโฟนถอดเสียงไม่ได้ (${event.error || 'unknown'})`);
    };
    recognition.onend = () => {
      if (recognitionRef.current === recognition) recognitionRef.current = null;
    };
    recognitionRef.current = recognition;
    try {
      recognition.start();
    } catch (error) {
      recognitionRef.current = null;
      setMicError(
        error instanceof Error
          ? error.message
          : 'ไม่สามารถเริ่มถอดเสียงจากไมโครโฟนได้',
      );
    }
  }, []);

  const stopBrowserSpeechRecognition = useCallback(() => {
    const transcript = browserTranscriptRef.current.trim();
    browserTranscriptRef.current = '';
    if (!recognitionRef.current) return transcript;
    try {
      recognitionRef.current.stop();
    } catch {
      recognitionRef.current.abort();
    } finally {
      recognitionRef.current = null;
    }
    return transcript;
  }, []);

  const sendInterruptSignal = useCallback(async () => {
    const room = roomRef.current;
    if (!room) return;
    const payload = new TextEncoder().encode(JSON.stringify({ type: 'interrupt' }));
    await room.localParticipant.publishData(payload, { reliable: true });
  }, []);

