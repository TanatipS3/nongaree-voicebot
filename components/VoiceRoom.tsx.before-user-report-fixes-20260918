        const line = rawLine.trim();
        const firstPipe = line.indexOf('|');
        if (firstPipe > 0) {
          const beforeTable = line.slice(0, firstPipe).trim();
          const tablePart = line.slice(firstPipe).trim();
          const tableCellCount = tablePart.split('|').filter((cell) => cell.trim()).length;
          if (beforeTable && tableCellCount >= 2) {
            normalizedLines.push(beforeTable);
            normalizedLines.push(tablePart);
            return;
          }
        }
        normalizedLines.push(rawLine);
      });
      return normalizedLines;
    }

    const lines = normalizeMarkdownTableLines(text);
    const blocks: ReactNode[] = [];
