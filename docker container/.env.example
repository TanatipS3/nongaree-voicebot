OPENAI_API_KEY=replace_with_openai_or_compatible_key
OPENAI_MODEL=replace_with_model_name
BASE_URL=https://your-llm-compatible-endpoint.example/v1
LLM_PROVIDER=openai
REQUEST_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO
NEXT_PUBLIC_SHOW_SESSION_HISTORY=true

DOCUMENT_DATA_PATH=data
RAG_INDEX_PATH=data/rag
RAG_TOP_K=8
RAG_SCORE_THRESHOLD=0.75
RAG_ENABLED=true

LIVEKIT_URL=wss://your-livekit-server.example
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret

STT_BASE_URL=https://your-stt-server.example/v1
STT_API_KEY=replace_with_stt_api_key
STT_MODEL=replace_with_stt_model

LLM_BASE_URL=https://your-llm-server.example/v1
LLM_API_KEY=replace_with_llm_api_key
LLM_MODEL=replace_with_llm_model
LLM_MODELS=replace_with_llm_model
ROUTER_MODEL=replace_with_router_model
GENERATE_MODEL=replace_with_generate_model
TEXT_GENERATE_MODEL=replace_with_text_generate_model

TTS_BASE_URL=https://your-tts-server.example/v1
TTS_API_KEY=replace_with_tts_api_key
TTS_MODEL=replace_with_tts_model
TTS_VOICE=replace_with_tts_voice

QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=thai_tax_kb

EMBEDDING_BASE_URL=https://your-embedding-server.example/v1
EMBEDDING_API_KEY=replace_with_embedding_api_key
EMBEDDING_MODEL=replace_with_embedding_model
