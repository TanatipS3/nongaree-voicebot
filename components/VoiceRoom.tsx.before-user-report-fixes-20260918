// getUserMedia rejects with DOMException names, not readable text. Surfacing
// error.message put English ("Permission denied", "Could not start audio source")
// into a Thai-only UI.
function describeMicError(error: unknown): string {
  const name = error instanceof DOMException ? error.name : '';
  switch (name) {
    case 'NotAllowedError':
    case 'SecurityError':
      return 'เบราว์เซอร์ปฏิเสธการใช้ไมโครโฟน กรุณาอนุญาตจากไอคอนรูปกุญแจที่แถบที่อยู่เว็บ';
    case 'NotFoundError':
    case 'OverconstrainedError':
      return 'ไม่พบไมโครโฟน กรุณาตรวจสอบการเชื่อมต่ออุปกรณ์';
    case 'NotReadableError':
    case 'AbortError':
      return 'ไมโครโฟนถูกใช้งานโดยโปรแกรมอื่นอยู่ กรุณาปิดโปรแกรมนั้นแล้วลองใหม่';
    default:
      return 'เชื่อมต่อไมโครโฟนไม่สำเร็จ กรุณากดลองเชื่อมต่ออีกครั้ง';
  }
}

// The avatar-emotion shortcut runs HERE, before a typed question is sent — a false match
// swallows the question and the agent never sees it. It used to fire on a command word and
// an emotion word anywhere in the text ("ทำ" in ทำระบบ + "ธรรมดา" in บุคคลธรรมดา), so real
// tax questions became "กลับสู่อารมณ์ปกติ". It now matches only a message that IS a command,
// anchored end to end. MUST stay equivalent to _manual_emotion_command() in graph/nodes.py.
const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const EMOTION_ALIAS_ALT = MANUAL_EMOTION_ALIASES
  .flatMap(([, aliases]) => aliases)
  .sort((a, b) => b.length - a.length)
  .map(escapeRegExp)
  .join('|');
const EMOTION_TARGET = '(?:สีหน้า|หน้า|ตา|อารมณ์|ท่าทาง)';
const THAI_EMOTION_COMMAND = new RegExp(
  `^(?:(?:ช่วย)?(?:ทำ|แสดง|เปลี่ยน|ขอ)(?:ให้)?(?:เป็น)?${EMOTION_TARGET}?(?:แบบ|เป็น|ให้)?` +
    `|${EMOTION_TARGET}(?:แบบ)?)` +
    `(${EMOTION_ALIAS_ALT})` +
    '(?:ให้ดู)?(?:หน่อย|ที|นะ|สิ|ได้ไหม|ได้มั้ย)?(?:ค่ะ|คะ|ครับ|จ้า)?$',
);
const EN_EMOTION_COMMAND = new RegExp(
  '^(?:please\\s+)?(?:show|make|set|use|do)\\s+(?:(?:a|an|the|me|your)\\s+)*' +
    `(${EMOTION_ALIAS_ALT})` +
    '(?:\\s+(?:face|emotion|mood|eyes?|expression))?(?:\\s+please)?[.!]?$',
);
const EN_EMOTION_NOUN = new RegExp(
  `^(${EMOTION_ALIAS_ALT})\\s+(?:face|emotion|mood|eyes?|expression)$`,
);

function getManualEmotionCommand(text: string): FaceMode | null {
  const normalized = text.trim().toLowerCase();
  if (!normalized) return null;
  const compact = normalized.replace(/\s+/g, '');

  let alias: string | null = null;
  for (const candidate of [normalized, compact]) {
    if (MANUAL_EMOTION_ALIASES.some(([, aliases]) => aliases.includes(candidate))) {
      alias = candidate;
      break;
    }
  }
  if (alias === null) {
    const match =
      THAI_EMOTION_COMMAND.exec(compact) ||
      EN_EMOTION_COMMAND.exec(normalized) ||
      EN_EMOTION_NOUN.exec(normalized);
    alias = match ? match[1] : null;
  }
  if (alias === null) return null;

  for (const [mode, aliases] of MANUAL_EMOTION_ALIASES) {
    if (aliases.includes(alias)) return mode;
  }
  return null;
}

function cleanPreviewText(text: string) {
  return text.replace(/[ \t]+/g, ' ').replace(/\n{3,}/g, '\n\n').trim();
}

async function copyTextToClipboard(text: string): Promise<boolean> {
  if (navigator.clipboard?.writeText) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // fall through to legacy fallback (e.g. non-secure context)
    }
  }
  const textarea = document.createElement('textarea');
  textarea.value = text;
  textarea.style.position = 'fixed';
  textarea.style.opacity = '0';
  document.body.appendChild(textarea);
  textarea.select();
  try {
    return document.execCommand('copy');
  } catch {
    return false;
  } finally {
    textarea.remove();
  }
}

function cleanDetailDisplayText(text: string) {
  return cleanPreviewText(text)
    .replace(/\s*(ค่ะ|ครับ|นะคะ|นะครับ|คะ)(?=([\s\n.,!?)]|$))/g, '')
    .replace(/[ \t]{2,}/g, ' ')
    .trim();
}

function shouldUseDefinitionTable(text: string, question: string) {
  const normalizedText = cleanDetailDisplayText(text);
  const normalizedQuestion = cleanPreviewText(question).toLowerCase();
  if (!normalizedText || /\|.+\|/.test(normalizedText)) return false;
  if (normalizedText === 'กำลังคิดคำตอบ...' || normalizedText === 'กำลังคิดคำตอบละเอียด...') {
    return false;
  }
  return (
    /คืออะไร|หมายถึง|แปลว่า|ใช้ทำอะไร|คือใคร/.test(normalizedQuestion) ||
    /(^|\s)(vat|e-filing|efiling)(\s|$)/i.test(normalizedQuestion) ||
    /ภ\.?\s*ง\.?\s*ด\.?/i.test(normalizedQuestion) ||
    /[0-9]+[a-z]+|[a-z]+[0-9]+/i.test(normalizedQuestion)
  );
}

function shouldUseSalaryBreakdown(text: string, question: string) {
  const normalizedText = cleanDetailDisplayText(text);
  const normalizedQuestion = cleanPreviewText(question).toLowerCase();
  if (!normalizedText || /\|.+\|/.test(normalizedText)) return false;
  return (
    (normalizedQuestion.includes('เงินเดือน') || normalizedQuestion.includes('เดือนละ')) &&
    /ภาษี|เสีย|ยื่น|ต้องจ่าย/.test(normalizedQuestion) &&
    /เงินได้สุทธิ|ภ\.ง\.ด\.91|120,?000|ลดหย่อน|ค่าใช้จ่าย/.test(normalizedText)
  );
}

function shouldUseDeductionBreakdown(text: string, question: string) {
  const normalizedText = cleanDetailDisplayText(text);
  const normalizedQuestion = cleanPreviewText(question).toLowerCase();
  if (!normalizedText || /\|.+\|/.test(normalizedText)) return false;
  return (
    /ลดหย่อน|ประกัน|กองทุน|ดอกเบี้ย|บริจาค/.test(normalizedQuestion) &&
    /ลดหย่อน|สูงสุด|เงื่อนไข|หลักฐาน|เบี้ยประกัน|จ่ายจริง/.test(normalizedText)
  );
}

function detailTags(text: string, question = '') {
  const normalized = cleanDetailDisplayText(text).toLowerCase();
  const tags: string[] = [];
  if (normalized === 'กำลังคิดคำตอบ...' || normalized === 'กำลังคิดคำตอบละเอียด...') {
    return ['LOADING'];
  }
  if (/\|.+\|/.test(normalized)) tags.push('TABLE');
  if (shouldUseSalaryBreakdown(text, question)) tags.push('CALC');
  if (shouldUseDeductionBreakdown(text, question)) tags.push('DEDUCTION');
  if (!tags.includes('TABLE') && shouldUseDefinitionTable(text, question)) tags.push('INFO');
  if (!tags.includes('CALC') && (normalized.includes('คำนวณ') || normalized.includes('เงินได้สุทธิ'))) {
    tags.push('CALC');
  }
  if (normalized.includes('ภ.ง.ด') || normalized.includes('ยื่นแบบ')) tags.push('FILING');
  if (!tags.includes('DEDUCTION') && (normalized.includes('ลดหย่อน') || normalized.includes('ประกัน'))) {
    tags.push('DEDUCTION');
  }
  if (normalized.includes('เงื่อนไข') || normalized.includes('ควรตรวจ')) tags.push('CONDITION');
  if (normalized && tags.length === 0) tags.push('ANSWER');
  return tags.slice(0, 4);
}

function parseThaiMoneyAmount(value: string) {
  const match = value.match(/([0-9][0-9,]*)\s*บาท/);
  return match ? Number(match[1].replace(/,/g, '')) : null;
}

function parseMonthlySalaryFromQuestion(question: string) {
  const cleanQuestion = cleanPreviewText(question);
  const explicitMonthlyPatterns = [
    /(?:เงินเดือน|รายได้ต่อเดือน|เดือนละ)\s*([0-9][0-9,]*)\s*บาท/,
    /([0-9][0-9,]*)\s*บาท\s*(?:ต่อเดือน|\/เดือน|ทุกเดือน|เดือนละ)/,
  ];

  for (const pattern of explicitMonthlyPatterns) {
    const match = cleanQuestion.match(pattern);
    if (match?.[1]) return Number(match[1].replace(/,/g, ''));
  }

  if (/เงินเดือน|เดือนละ/.test(cleanQuestion)) {
    return parseThaiMoneyAmount(cleanQuestion);
  }

  return null;
}

export default function VoiceRoom({ roomName }: Props) {
  const [needsAudioUnlock, setNeedsAudioUnlock] = useState(false);
  const [loggedOut, setLoggedOut] = useState(false);
  const [status, setStatus] = useState<ConnectionStatus>('connecting');
  const [micReady, setMicReady] = useState(false);
  const [micError, setMicError] = useState('');
  // Bumping this re-runs the room effect, which tears the old room down in its
  // cleanup and rebuilds connection + mic from scratch. Cheaper and far less
  // error-prone than a bespoke reconnect path.
  const [connectAttempt, setConnectAttempt] = useState(0);
  // Chunks the current answer was built from. Replaced every turn, including with
  // an empty list on non-rag routes so stale markers never outlive their answer.
  const [sources, setSources] = useState<AnswerSource[]>([]);
  const [openSource, setOpenSource] = useState<number | null>(null);
  const [diagnostics, setDiagnostics] = useState<AnswerDiagnostics>({});
  // The DOMException NAME, kept separately from the Thai message shown to the user:
  // names are stable and aggregatable, the copy is presentation and will change.
  const [micErrorName, setMicErrorName] = useState('');
  const [reportOpen, setReportOpen] = useState(false);
  const [reportType, setReportType] = useState(REPORT_TYPES[0].value);
  const [reportMessage, setReportMessage] = useState('');
  const [reportState, setReportState] = useState<'idle' | 'sending' | 'sent' | 'error'>('idle');
  const lastInputModeRef = useRef<'typed' | 'voice'>('typed');
  const [isTalking, setIsTalking] = useState(false);
  const [isAgentSpeaking, setIsAgentSpeaking] = useState(false);
  const [textInput, setTextInput] = useState('');
  const [currentUserText, setCurrentUserText] = useState('');
  const [speechPreview, setSpeechPreview] = useState('');
  const [detailPreview, setDetailPreview] = useState('');
  const [sessionHistory, setSessionHistory] = useState<SessionHistoryEntry[]>([]);
  const [sessionHistoryOpen, setSessionHistoryOpen] = useState(false);
  const [copiedAnswer, setCopiedAnswer] = useState(false);
  const [copiedHistoryId, setCopiedHistoryId] = useState<string | null>(null);
  const [answerHovered, setAnswerHovered] = useState(false);
  const [pendingQueue, setPendingQueue] = useState<string[]>([]);
  const [turnActive, setTurnActive] = useState(false);
  const faceRef = useRef<LumoFaceHandle>(null);
  const roomRef = useRef<Room | null>(null);
  const localAudioTrackRef = useRef<LocalAudioTrack | null>(null);
  const recognitionRef = useRef<BrowserSpeechRecognition | null>(null);
  const browserTranscriptRef = useRef('');
  const talkingActiveRef = useRef(false);
  const stopTalkingInFlightRef = useRef(false);
  const interruptOnSpeechRef = useRef(false);
  const interruptSentRef = useRef(false);
  const gazeStateRef = useRef<GazeState>('idle');
  const isAgentSpeakingRef = useRef(false);
  const speechPreviewRef = useRef('');
  const lastVoiceDeltaRef = useRef('');
  const detailPreviewRef = useRef('');
  // A new turn has started but none of its answer has arrived yet, so the panel is
  // still showing the PREVIOUS turn's question and answer. Cleared by the first
  // token of the new answer (or by the response timeout).
  const supersedeOnNextDeltaRef = useRef(false);
  const pendingUserTextRef = useRef('');
  const [awaitingAnswer, setAwaitingAnswer] = useState(false);
  const activeHistoryIdRef = useRef('');
  const responseTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);
  const agentRedispatchCountRef = useRef(0);
  // Which halves of the current turn have reported. The 35s response timeout is the
  // only thing that can un-stick a turn whose other half never arrives, so it must stay
  // armed until BOTH the panel and the voice side have been heard from.
  const panelSeenRef = useRef(false);
  const voiceSeenRef = useRef(false);
  // Seeded on mount rather than during render — Date.now() is impure and must not
  // be called in the render body.
  const lastActivityRef = useRef(0);
  const pendingQueueRef = useRef<string[]>([]);
  const turnActiveRef = useRef(false);
  const settleTimerRef = useRef<ReturnType<typeof setTimeout> | null>(null);

  // Login is SSO-only, so logout just clears the session and closes the tab.
  // window.close() is a no-op for tabs the browser did not open via script
  // (the RD SSO portal navigates here), so a "you may close this window" notice
  // is shown as a fallback instead of redirecting anywhere.
  const handleLogout = useCallback(async () => {
    // Tear the media session down first: rendering the logged-out screen does not
    // unmount this component, so the room-connection effect's cleanup never runs
    // and the mic track would stay published after logout.
    localAudioTrackRef.current?.stop();
    localAudioTrackRef.current = null;
    recognitionRef.current?.abort();
    recognitionRef.current = null;
    roomRef.current?.disconnect();
    roomRef.current = null;

    try {
      // Clear stored conversation memory FIRST: /api/session/memory is session-gated,
      // so it must run while the cookie is still valid. Signing out should not leave a
      // transcript of the user's salary, dependants and ages on disk.
      // Best-effort — the 30-minute TTL removes it anyway, and logout must not block.
      await fetch('/api/session/memory', { method: 'DELETE' });
    } catch {
      // ignore — the TTL will expire it
    }

    try {
      await fetch('/api/auth/sso/logout', { method: 'POST' });
    } catch {
      // ignore network errors — the session cookie is cleared server-side or expires
    }
    setLoggedOut(true);
    window.close();
  }, []);

  useEffect(() => {
    const IDLE_LIMIT_MS = 30 * 60 * 1000;
    lastActivityRef.current = Date.now();

    const idleCheck = setInterval(() => {
      if (Date.now() - lastActivityRef.current > IDLE_LIMIT_MS) {
        clearInterval(idleCheck);
        void handleLogout();
      }
    }, 15_000);

    return () => {
      clearInterval(idleCheck);
    };
  }, [handleLogout]);

  function setGaze(state: GazeState) {
    if (gazeStateRef.current === state) return;
    gazeStateRef.current = state;
    faceRef.current?.setGazeState(state);
  }

  function clearResponseTimeout() {
    if (!responseTimeoutRef.current) return;
    clearTimeout(responseTimeoutRef.current);
    responseTimeoutRef.current = null;
  }

  // Called as each half of an answer arrives. The timeout used to be cancelled by the
  // first PANEL token alone, so a turn whose spoken side produced nothing (observed live:
  // an empty spoken reply, so no voice_delta and no voice_answer) left the
  // 'กำลังเตรียมคำตอบสั้น...' placeholder up with nothing left to clear it — caption
  // stuck on กำลังคิด and every later question queued forever. Keeping the timeout armed
  // until both halves report makes it the backstop for whichever half goes missing; its
  // handler already leaves a delivered panel answer alone.
  function noteAnswerProgress(side: 'panel' | 'voice') {
    if (side === 'panel') panelSeenRef.current = true;
    else voiceSeenRef.current = true;
    if (panelSeenRef.current && voiceSeenRef.current) clearResponseTimeout();
  }

  const setSmartDetailPreview = useCallback((text: string) => {
    setDetailPreview(text);
  }, []);

  const startSessionHistoryEntry = useCallback((question: string) => {
    if (!SHOW_SESSION_HISTORY || !question.trim()) return;
    const cleanQuestion = cleanPreviewText(question);
    const now = new Date();
    const entry: SessionHistoryEntry = {
      id: `${now.getTime()}-${Math.random().toString(36).slice(2)}`,
      question: cleanQuestion,
      voiceAnswer: '',
      detailAnswer: '',
      time: now.toLocaleTimeString('th-TH', {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
      }),
    };
    activeHistoryIdRef.current = entry.id;
    setSessionHistory((previous) => {
      const lastEntry = previous[previous.length - 1];
      if (
        lastEntry
        && lastEntry.question === cleanQuestion
        && !lastEntry.voiceAnswer
        && !lastEntry.detailAnswer
      ) {
        activeHistoryIdRef.current = lastEntry.id;
        return previous;
      }
      return [...previous, entry].slice(-MAX_SESSION_HISTORY_ENTRIES);
    });
  }, []);

  const updateSessionHistoryEntry = useCallback((
    field: 'voiceAnswer' | 'detailAnswer',
    text: string,
  ) => {
    if (!SHOW_SESSION_HISTORY || !activeHistoryIdRef.current || !text.trim()) return;
    const cleanText = cleanPreviewText(text);
    setSessionHistory((previous) => previous.map((entry) => (
      entry.id === activeHistoryIdRef.current
        ? { ...entry, [field]: cleanText }
        : entry
    )));
  }, []);

  // Start a turn WITHOUT clearing the panel. The previous question and answer stay
  // visible (with a LOADING badge) until the new answer produces its first token.
  function beginPendingAnswer(question: string) {
    supersedeOnNextDeltaRef.current = true;
    pendingUserTextRef.current = question;
    setAwaitingAnswer(true);
    if (!detailPreviewRef.current) {
      setSmartDetailPreview('กำลังคิดคำตอบละเอียด...');
    }
  }

  // First content of the new answer arrived: swap question and answer together.
  function commitPendingAnswer() {
    if (!supersedeOnNextDeltaRef.current) return;
    supersedeOnNextDeltaRef.current = false;
    detailPreviewRef.current = '';
    if (pendingUserTextRef.current) {
      setCurrentUserText(pendingUserTextRef.current);
      pendingUserTextRef.current = '';
    }
    setAwaitingAnswer(false);
  }

  function startResponseTimeout() {
    clearResponseTimeout();
    panelSeenRef.current = false;
    voiceSeenRef.current = false;
    responseTimeoutRef.current = setTimeout(() => {
      responseTimeoutRef.current = null;
      // Clear the short-answer placeholder from STATE, via an updater because this
      // closure holds stale state. It used to test `speechPreviewRef.current` instead,
      // but the placeholder never lives in the ref: sendTextMessage and the chat_user
      // handler deliberately leave the ref '' (so voice_delta can append into it) while
      // setting only the state. The ref check could never be true, the placeholder
      // survived the timeout, `rawBusy` stayed true, the settle timer never started,
      // `turnActive` never cleared — and every later question was queued client-side
      // forever ("จะส่งเมื่ออารีพูดจบ" / เข้าคิว, caption stuck on กำลังคิด). Any turn
      // that went unanswered for 35s froze the UI until reload: an agent still cold-
      // starting when the first question is typed, a dropped packet, an agent restart.
      setSpeechPreview((current) => (current === 'กำลังเตรียมคำตอบสั้น...' ? '' : current));
      if (supersedeOnNextDeltaRef.current) {
        // A turn started but nothing ever came back, so the panel is still showing
        // the PREVIOUS answer. Leaving it there would misattribute it to the new
        // question, so replace it; the old answer remains in the session history.
        commitPendingAnswer();
        detailPreviewRef.current = 'ยังไม่ได้รับคำตอบจากบอท กรุณาลองถามอีกครั้ง';
        setSmartDetailPreview(detailPreviewRef.current);
      } else if (
        detailPreviewRef.current === '' ||
        detailPreviewRef.current === 'กำลังคิดคำตอบ...' ||
        detailPreviewRef.current === 'กำลังคิดคำตอบละเอียด...'
      ) {
        detailPreviewRef.current = 'ยังไม่ได้รับคำตอบจากบอท กรุณาลองถามอีกครั้ง';
        setSmartDetailPreview(detailPreviewRef.current);
      }
      setGaze('idle');
    }, RESPONSE_THINKING_TIMEOUT_MS);
  }

  function renderInlineMarkdown(text: string): ReactNode[] {
    return text
      .split(/(<br\s*\/?>|`[^`]+`|\*\*[^*]+\*\*|\*[^*]+\*)/gi)
      .filter(Boolean)
      .map((part, index) => {
      if (/^<br\s*\/?>$/i.test(part)) {
        return <br key={index} />;
      }
      if (part.startsWith('`') && part.endsWith('`')) {
        return (
          <code
            key={index}
            style={{
              borderRadius: 4,
              background: 'rgba(255,255,255,0.12)',
              color: '#fff',
              fontFamily: 'monospace',
              fontSize: '0.92em',
              padding: '1px 5px',
            }}
          >
            {part.slice(1, -1)}
          </code>
        );
      }
      if (part.startsWith('**') && part.endsWith('**')) {
        return <strong key={index}>{part.slice(2, -2)}</strong>;
      }
      if (part.startsWith('*') && part.endsWith('*')) {
        return <em key={index}>{part.slice(1, -1)}</em>;
      }
      return <span key={index}>{part}</span>;
    });
  }

  function cleanTableCellPart(part: string) {
    return cleanDetailDisplayText(
      part
        .replace(/^\s*(?:[•*]|[-–])\s*/g, '')
        .replace(/^\s*(?:[•*]|[-–])\s*/g, '')
        .replace(/\*\*/g, ''),
    );
  }

  function renderTableCell(cell: string) {
    const parts = cell
      .split(/<br\s*\/?>/gi)
      .map((part) => cleanTableCellPart(part))
      .filter(Boolean);

    if (parts.length <= 1) {
      return renderInlineMarkdown(cleanTableCellPart(cell));
    }

    return (
      <div style={{ display: 'grid', gap: 2 }}>
        {parts.map((part, partIndex) => (
          <div
            key={partIndex}
            style={{
              display: 'grid',
              gridTemplateColumns: '8px minmax(0, 1fr)',
              gap: 5,
              alignItems: 'start',
            }}
          >
            <span style={{ color: '#3ea3cb', lineHeight: 1.4 }}>•</span>
            <span>{renderInlineMarkdown(part)}</span>
          </div>
        ))}
      </div>
    );
  }

