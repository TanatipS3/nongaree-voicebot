    try {
      talkingActiveRef.current = true;
      interruptOnSpeechRef.current = isAgentSpeakingRef.current;
      interruptSentRef.current = false;
      if (localTrack) await localTrack.unmute();
      else await micPub?.unmute();
      setMicError('');
      startBrowserSpeechRecognition();
      setGaze('user_talking');
      setIsTalking(true);
